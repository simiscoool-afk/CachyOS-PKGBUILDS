diff --git a/usr/bin/steamos-session-select b/usr/bin/steamos-session-select
index 96cc0c8..76ceab0 100755
--- a/usr/bin/steamos-session-select
+++ b/usr/bin/steamos-session-select
@@ -14,7 +14,6 @@ case "$1" in
         qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout;;
     'plasma')
         pkexec /usr/lib/steamos/steam-set-session plasma.desktop
-        steam -shutdown
         systemctl --user stop gamescope-session.target;;
     *)
         [[ -n "$1" ]] && echo -e "Unknown session '$1'\n"
diff --git a/usr/lib/steamos/steam-set-session b/usr/lib/steamos/steam-set-session
index b082209..7f34956 100755
--- a/usr/lib/steamos/steam-set-session
+++ b/usr/lib/steamos/steam-set-session
@@ -2,17 +2,23 @@
 set -e
 
 DISPLAY_MANAGER="$(systemctl show -p Id --value display-manager)"
+SESSION="${1:-gamescope-session.desktop}"
+case "$SESSION" in
+    gamescope-session.desktop|plasma.desktop) ;;
+    *) echo "Unsupported session: $SESSION" >&2; exit 1;;
+esac
+
 case "${DISPLAY_MANAGER%.service}" in
-    plasmalogin) CONF_FILE="/etc/plasmalogin.conf.d/zz-steamos-autologin.conf";;
+    plasmalogin)
+        # New drop-ins are ignored until PLM restarts; update its main config.
+        kwriteconfig6 --file /etc/plasmalogin.conf --group Autologin --key Session "$SESSION"
+        exit 0;;
     sddm) CONF_FILE="/etc/sddm.conf.d/zz-steamos-autologin.conf";;
 esac
 
 # Don't do anything if system is using unsupported display manager
 [[ -z "$CONF_FILE" ]] && exit 0
 
-# Session, gamescope or plasma
-SESSION="${1:-gamescope-session.desktop}"
-
 if [[ ! -d "$(dirname "$CONF_FILE")" ]]; then
     mkdir -p "$(dirname "$CONF_FILE")"
 fi

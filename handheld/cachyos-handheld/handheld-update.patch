index 0000000..ecab2c9
--- /dev/null
+++ b/tests/test_steam_updater_setup.py
@@ -0,0 +1,153 @@
+import importlib.machinery
+import importlib.util
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import patch
+
+import vdf
+
+
+SCRIPT = Path(__file__).resolve().parents[1] / "usr/lib/cachyos-handheld/setup-steam-updater"
+LOADER = importlib.machinery.SourceFileLoader("setup_steam_updater", str(SCRIPT))
+SPEC = importlib.util.spec_from_loader(LOADER.name, LOADER)
+setup = importlib.util.module_from_spec(SPEC)
+LOADER.exec_module(setup)
+
+
+class RegistrationTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.home = Path(temporary.name)
+        self.root = self.home / "Steam library"
+        self.root.joinpath("config").mkdir(parents=True)
+        self.home.joinpath(".steam").mkdir()
+        self.home.joinpath(".steam/steam").symlink_to(self.root)
+        self.state = self.home / "state"
+        self.state.mkdir()
+        self.user(1, "first")
+        self.select("first")
+        self.client = patch.object(setup, "steam_process", return_value=("launch-one", 100))
+        self.client.start()
+        self.addCleanup(self.client.stop)
+        self.request = patch.object(setup.subprocess, "run")
+        self.run = self.request.start()
+        self.addCleanup(self.request.stop)
+
+    def write_vdf(self, path, data):
+        path.write_text(vdf.dumps(data), encoding="utf-8")
+
+    def user(self, account, name, timestamp="101"):
+        path = self.root / "config/loginusers.vdf"
+        users = vdf.loads(path.read_text())["users"] if path.exists() else {}
+        users[str(setup.STEAM_ID_BASE + account)] = {"AccountName": name, "Timestamp": timestamp}
+        self.write_vdf(path, {"users": users})
+        self.root.joinpath("userdata", str(account), "config").mkdir(parents=True, exist_ok=True)
+
+    def select(self, name):
+        self.write_vdf(self.home / ".steam/registry.vdf", {
+            "Registry": {"HKCU": {"Software": {"Valve": {"Steam": {"AutoLoginUser": name}}}}}
+        })
+
+    def shortcuts(self, account, entries):
+        path = self.root / "userdata" / str(account) / "config/shortcuts.vdf"
+        data = vdf.binary_dumps({"shortcuts": {str(i): entry for i, entry in enumerate(entries)}})
+        path.write_bytes(data)
+        return path
+
+    def tick(self):
+        setup.setup(self.home, self.state)
+
+    def test_waits_for_a_login_in_this_steam_launch(self):
+        self.user(1, "first", timestamp="99")
+        self.tick()
+        self.run.assert_not_called()
+        self.user(1, "first", timestamp="101")
+        self.tick()
+        self.run.assert_called_once_with(
+            ["/usr/bin/steamos-add-to-steam", setup.LAUNCHER], check=True, timeout=10)
+
+    def test_waits_when_steam_is_not_running(self):
+        with patch.object(setup, "steam_process", return_value=None):
+            self.tick()
+        self.run.assert_not_called()
+
+    def test_requests_once_then_confirms_steams_own_database(self):
+        other = self.shortcuts(1, [{"AppName": "Keep me", "Exe": '"/usr/bin/another-app"'}])
+        original = other.read_bytes()
+        self.tick()
+        self.tick()
+        self.run.assert_called_once()
+        self.assertEqual(other.read_bytes(), original)
+        self.assertFalse(json.loads(self.state.joinpath("1.json").read_text()).get("registered"))
+        # Simulate Steam persisting the requested shortcut, not the setup helper.
+        self.shortcuts(1, [{"Exe": f'"{setup.EXECUTABLE}"'}])
+        self.tick()
+        self.assertTrue(json.loads(self.state.joinpath("1.json").read_text())["registered"])
+        self.run.assert_called_once()
+
+    def test_existing_manual_shortcut_is_not_duplicated(self):
+        self.shortcuts(1, [{"AppName": "Renamed updater", "Exe": setup.EXECUTABLE}])
+        self.tick()
+        self.run.assert_not_called()
+        self.assertTrue(json.loads(self.state.joinpath("1.json").read_text())["registered"])
+
+    def test_removed_registered_shortcut_stays_removed(self):
+        path = self.shortcuts(1, [{"ShortcutPath": setup.LAUNCHER}])
+        self.tick()
+        path.unlink()
+        self.tick()
+        self.run.assert_not_called()
+
+    def test_each_account_has_independent_registration(self):
+        self.user(2, "second")
+        self.shortcuts(1, [{"Exe": setup.EXECUTABLE}])
+        self.tick()
+        self.select("second")
+        self.tick()
+        self.assertTrue(self.state.joinpath("1.json").exists())
+        self.assertTrue(self.state.joinpath("2.json").exists())
+        self.run.assert_called_once()
+
+    def test_account_change_before_request_defers_registration(self):
+        with patch.object(setup, "active_account", side_effect=["1", "2"]):
+            self.tick()
+        self.run.assert_not_called()
+        self.assertFalse(self.state.joinpath("1.json").exists())
+
+    def test_failed_request_retries_without_marking_success(self):
+        self.run.side_effect = subprocess.CalledProcessError(1, "steam")
+        with self.assertRaises(subprocess.CalledProcessError):
+            self.tick()
+        self.assertFalse(self.state.joinpath("1.json").exists())
+        self.run.side_effect = None
+        self.tick()
+        self.assertEqual(self.run.call_count, 2)
+
+    def test_unconfirmed_request_retries_after_steam_restarts(self):
+        self.tick()
+        with patch.object(setup, "steam_process", return_value=("launch-two", 100)):
+            self.tick()
+        self.assertEqual(self.run.call_count, 2)
+
+    def test_legacy_most_recent_login_is_supported(self):
+        self.select("")
+        self.write_vdf(self.root / "config/loginusers.vdf", {"users": {
+            str(setup.STEAM_ID_BASE + 1): {"MostRecent": "1", "Timestamp": "101"}}})
+        self.tick()
+        self.run.assert_called_once()
+
+    def test_corrupt_shortcuts_are_not_modified_or_added_to(self):
+        path = self.shortcuts(1, [])
+        path.write_bytes(b"invalid")
+        with self.assertRaises(SyntaxError):
+            self.tick()
+        self.assertEqual(path.read_bytes(), b"invalid")
+        self.run.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/usr/bin/cachyos-handheld-update b/usr/bin/cachyos-handheld-update
new file mode 100755
index 0000000..3eaa8a6
--- /dev/null
+++ b/usr/bin/cachyos-handheld-update
@@ -0,0 +1,24 @@
+#!/usr/bin/bash
+
+if [[ ${1:-} != --run ]]; then
+    exec konsole --separate --fullscreen -e "$0" --run
+fi
+
+printf 'CachyOS system update\n\nSave your game and close running games before continuing.\n'
+printf 'Use Steam + X to open the on-screen keyboard.\n'
+printf 'Enter your account password when sudo asks for it.\n\n'
+
+# A full upgrade runs the same pacman snapshot hooks as desktop mode.
+# Keep authentication and pacman's transaction confirmation interactive.
+systemd-inhibit --what=sleep:idle --mode=block \
+    --who='CachyOS system update' --why='Updating system packages' \
+    sudo pacman -Syu
+status=$?
+
+if (( status == 0 )); then
+    printf '\nUpdate complete. Restart from Steam after a kernel or driver update.\n'
+else
+    printf '\nUpdate exited with status %s. Review the messages above.\n' "$status"
+fi
+read -r -p 'Press Enter to close this window. ' _
+exit "$status"
diff --git a/usr/lib/cachyos-handheld/setup-steam-updater b/usr/lib/cachyos-handheld/setup-steam-updater
new file mode 100755
index 0000000..71561af
--- /dev/null
+++ b/usr/lib/cachyos-handheld/setup-steam-updater
@@ -0,0 +1,127 @@
+#!/usr/bin/python
+"""Register the updater through Steam, once per local Steam account."""
+
+import fcntl
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+import vdf
+
+
+LAUNCHER = "/usr/share/applications/cachyos-handheld-update.desktop"
+EXECUTABLE = "/usr/bin/cachyos-handheld-update"
+STEAM_ID_BASE = 76561197960265728
+
+
+def lowercase_keys(value):
+    if isinstance(value, dict):
+        return {key.lower(): lowercase_keys(item) for key, item in value.items()}
+    return value
+
+
+def read_text_vdf(path):
+    with path.open(encoding="utf-8") as stream:
+        return lowercase_keys(vdf.load(stream))
+
+
+def steam_process(home):
+    pid = int((home / ".steam/steam.pid").read_text())
+    process = Path("/proc") / str(pid)
+    if process.stat().st_uid != os.getuid() or process.joinpath("comm").read_text().strip() != "steam":
+        return None
+    fields = process.joinpath("stat").read_text().rsplit(")", 1)[1].split()
+    ticks = int(fields[19])
+    boot_time = next(int(line.split()[1]) for line in Path("/proc/stat").read_text().splitlines()
+                     if line.startswith("btime "))
+    boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
+    return f"{boot_id}:{pid}:{ticks}", boot_time + ticks / os.sysconf("SC_CLK_TCK")
+
+
+def active_account(home, root, started):
+    users = read_text_vdf(root / "config/loginusers.vdf")["users"]
+    registry = read_text_vdf(home / ".steam/registry.vdf")
+    steam = registry["registry"]["hkcu"]["software"]["valve"]["steam"]
+    name = steam.get("autologinuser", "").lower()
+    for steam_id, user in users.items():
+        selected = user.get("accountname", "").lower() == name if name else user.get("mostrecent") == "1"
+        # A remembered account alone does not mean this Steam launch has logged in.
+        if not selected or int(user.get("timestamp", "0")) < int(started):
+            continue
+        account = int(steam_id) - STEAM_ID_BASE
+        if 0 < account < 2**32 and root.joinpath("userdata", str(account), "config").is_dir():
+            return str(account)
+    return None
+
+
+def has_updater(path):
+    if not path.exists():
+        return False
+    with path.open("rb") as stream:
+        shortcuts = lowercase_keys(vdf.binary_load(stream))["shortcuts"]
+    return any(item.get("exe", "").strip('"') == EXECUTABLE
+               or item.get("shortcutpath") == LAUNCHER for item in shortcuts.values())
+
+
+def save_state(path, value):
+    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
+        temporary = Path(stream.name)
+        try:
+            json.dump(value, stream)
+            stream.flush()
+            os.replace(temporary, path)
+        finally:
+            temporary.unlink(missing_ok=True)
+
+
+def setup(home, state_dir):
+    process = steam_process(home)
+    if process is None:
+        return
+    launch, started = process
+    root = home / ".steam/steam"
+    account = active_account(home, root, started)
+    if account is None:
+        return
+    state_file = state_dir / f"{account}.json"
+    state = json.loads(state_file.read_text()) if state_file.exists() else {}
+    if state.get("registered"):
+        return  # Respect a shortcut the user subsequently removes.
+    if has_updater(root / "userdata" / account / "config/shortcuts.vdf"):
+        save_state(state_file, {"registered": True})
+        return
+    if state.get("requested_launch") == launch:
+        return  # Steam may not have saved its shortcut database yet.
+    if steam_process(home) != process or active_account(home, root, started) != account:
+        return
+    subprocess.run(["/usr/bin/steamos-add-to-steam", LAUNCHER], check=True, timeout=10)
+    # Only mark registration complete after Steam's own database confirms it.
+    save_state(state_file, {"requested_launch": launch})
+
+
+def main():
+    if os.getuid() == 0:
+        return 1
+    home = Path.home()
+    state_dir = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "cachyos-handheld/steam-updater"
+    state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
+    with state_dir.joinpath(".lock").open("w") as lock:
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            return 0
+        try:
+            setup(home, state_dir)
+        except FileNotFoundError:
+            return 0  # Steam is not installed, is starting, or has just exited.
+        except (OSError, ValueError, KeyError, SyntaxError, subprocess.SubprocessError) as error:
+            print(f"Updater shortcut setup deferred: {type(error).__name__}", file=sys.stderr)
+            return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

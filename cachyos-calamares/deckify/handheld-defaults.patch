diff --git a/src/scripts/btrfs-installation-snapshot b/src/scripts/btrfs-installation-snapshot
index 8c49241..917ea3b 100755
--- a/src/scripts/btrfs-installation-snapshot
+++ b/src/scripts/btrfs-installation-snapshot
@@ -1,7 +1,8 @@
 #!/bin/bash
+set -euo pipefail
 
 # Only proceed if cachyos-snapper-support is installed (present on all btrfs installs)
-if ! pacman -Qs cachyos-snapper-support > /dev/null 2>&1; then
+if ! pacman -Qq cachyos-snapper-support > /dev/null 2>&1; then
     exit 0
 fi
 
@@ -13,5 +14,10 @@ SNAP_ID=$(snapper --no-dbus -c root create --print-number \
     --description "Fresh CachyOS Installation" \
     --userdata "important=yes")
 
+if [[ ! "$SNAP_ID" =~ ^[1-9][0-9]*$ ]]; then
+    echo "Snapper did not return a valid installation snapshot ID" >&2
+    exit 1
+fi
+
 mkdir -p /etc/cachyos
 echo "$SNAP_ID" > /etc/cachyos/installation-snapshot
